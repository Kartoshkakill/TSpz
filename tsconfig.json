{
  "compilerOptions": {
    "target": "ES6",           // До якої версії JS компілювати
    "module": "commonjs",      // Система модулів
    "strict": true,            // Увімкнути строгий режим перевірки типів
    "rootDir": "src",          // Де лежать вихідні TS-файли
    "outDir": "dist"           // Куди зберігати зкомпільовані JS-файли
  }
}
